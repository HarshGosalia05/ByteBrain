# =============================================================================
# CampusX Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit real
# secrets. All values below are safe placeholders.
#
#   cp .env.example .env.local
# =============================================================================

# --- App / Frontend (Next.js 16 BFF) -----------------------------------------
PROJECT_NAME="CampusX Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
NODE_ENV="production"
CURRENT_ACADEMIC_YEAR="2026-27"

# --- Database (Supabase-hosted PostgreSQL) -----------------------------------
DB_HOST="your-project.supabase.co"
DB_PORT="5432"
DB_NAME="postgres"
DB_USER="postgres"
DB_PASSWORD="your-db-password"

# --- Supabase API & Auth (Optional facade integrations) -----------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# --- Backend Connectivity & CORS ----------------------------------------------
# In Docker Compose, the frontend BFF talks to FastAPI via the internal network:
# FASTAPI_URL="http://CampusX-backend:8000"
# For local host development without Docker:
FASTAPI_URL="http://localhost:8000"

# CORS origins accepted by the FastAPI backend (JSON array or comma-separated):
CORS_ORIGINS="http://localhost:3000"

# --- Auth (JWT Shared Secret) ------------------------------------------------
# SHARED secret used by BOTH the Next.js session signer and the FastAPI verifier.
# Use a long random string (>= 32 bytes). Example generation:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-bytes"

# --- GenAI / LLM Providers ----------------------------------------------------
# Supported: "groq" | "ollama" | "openai_compatible"
GENAI_PRIMARY_PROVIDER="groq"
GENAI_FALLBACK_PROVIDER="ollama"
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_BASE_URL="http://localhost:11434/v1"

# --- Legacy Single-Provider GenAI (Used only if GENAI_PRIMARY_PROVIDER is empty)
GENAI_PROVIDER="openai_compatible"
GENAI_MODEL="qwen2.5:3b"
GENAI_PRIMARY_MODEL="qwen2.5:3b"
GENAI_FALLBACK_MODEL_1=""
GENAI_FALLBACK_MODEL_2=""
GENAI_API_KEY="your-genai-api-key"
GENAI_BASE_URL="http://localhost:11434/v1/"

# --- Chat Endpoint Rate Limiting ----------------------------------------------
CHAT_RATE_LIMIT_PER_MINUTE="30"
CHAT_RATE_LIMIT_BURST="10"
