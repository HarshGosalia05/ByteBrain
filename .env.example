# =============================================================================
# CampusX / KenexAI environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit real
# secrets. All values below are placeholders.
#
#   cp .env.example .env.local
# =============================================================================

# --- App / Next.js -----------------------------------------------------------
PROJECT_NAME="KenexAI SaaS Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
CURRENT_ACADEMIC_YEAR="2026-27"

# --- Supabase / Auth (optional; used by facade integrations) -----------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-me"
SUPABASE_ANON_KEY="replace-me"
SUPABASE_JWT_SECRET="replace-me"

# --- Database ----------------------------------------------------------------
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="postgres"
DB_USER="postgres"
DB_PASSWORD="replace-me"

# --- Backend / BFF connectivity ----------------------------------------------
FASTAPI_URL="http://localhost:8000"

# --- GenAI / LLM (Groq primary + Ollama Qwen2.5:3B fallback) ----------------
# Provider selection is configuration-driven. GENAI_PRIMARY_PROVIDER names the
# primary provider and GENAI_FALLBACK_PROVIDER the failover used on transient
# errors (timeout / connection / server / rate-limit). Supported: "groq" |
# "ollama" | "openai_compatible". Leave GENAI_PRIMARY_PROVIDER empty to use the
# legacy single-provider path (GENAI_PROVIDER) below.
GENAI_PRIMARY_PROVIDER="groq"
GENAI_FALLBACK_PROVIDER="ollama"
GROQ_API_KEY="replace-me"                      # Groq secret - never commit a real key
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_BASE_URL="http://localhost:11434/v1"

# --- Legacy single-provider path (used only when GENAI_PRIMARY_PROVIDER is empty)
GENAI_PROVIDER="openai_compatible"
GENAI_MODEL="qwen2.5:3b"
GENAI_PRIMARY_MODEL="qwen2.5:3b"
GENAI_FALLBACK_MODEL_1=""
GENAI_FALLBACK_MODEL_2=""
GENAI_API_KEY="replace-me"
GENAI_BASE_URL="http://localhost:11434/v1/"

# --- Auth (JWT) --------------------------------------------------------------
# SHARED secret used by BOTH the Next.js session signer and the FastAPI
# verifier. Use a long random value (>= 32 bytes). Example generation:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-bytes"

# --- Chat endpoint rate limiting (per user/min; burst ceiling) --------------
CHAT_RATE_LIMIT_PER_MINUTE="30"
CHAT_RATE_LIMIT_BURST="10"
