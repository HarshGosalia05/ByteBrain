# =============================================================================
# CampusX Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit real
# secrets. All values below are safe placeholders.
#
#   cp .env.example .env.local
#
# For Render deployment, set these as Environment Variables in the Render
# Dashboard. Do NOT commit .env.local to source control.
# =============================================================================

# --- App / Frontend (Next.js 16 BFF) -----------------------------------------
PROJECT_NAME="CampusX Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
NODE_ENV="production"
CURRENT_ACADEMIC_YEAR="2026-27"

# --- Database -----------------------------------------------------------------
# Option 1: Individual fields (both backend and frontend auto-build the DSN)
DB_HOST="your-project.supabase.co"
DB_PORT="5432"
DB_NAME="postgres"
DB_USER="postgres.your-project-ref"
DB_PASSWORD="your-db-password"

# Option 2: Full connection string (takes precedence over DB_HOST/PORT/etc.)
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Supabase API & Auth (Optional facade integrations) -----------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# --- Backend Connectivity & CORS ----------------------------------------------
# In Docker Compose, the frontend BFF talks to FastAPI via the internal network:
# FASTAPI_URL="http://CampusX-backend:8000"
# For local host development without Docker:
FASTAPI_URL="http://localhost:8000"
# For Render: set FASTAPI_URL to your backend service's external URL
# FASTAPI_URL="https://campusx-backend.onrender.com"

# CORS origins accepted by the FastAPI backend (JSON array or comma-separated):
CORS_ORIGINS="http://localhost:3000"
# For Render production, include your frontend URL:
# CORS_ORIGINS="https://campusx-frontend.onrender.com,http://localhost:3000"

# --- Auth (JWT Shared Secret) ------------------------------------------------
# SHARED secret used by BOTH the Next.js session signer and the FastAPI verifier.
# Use a long random string (>= 32 bytes). Example generation:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-bytes"

# --- GenAI / LLM Providers ----------------------------------------------------
# Supported: "groq" | "ollama" | "openai_compatible"
GENAI_PRIMARY_PROVIDER="groq"
GENAI_FALLBACK_PROVIDER="ollama"
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_BASE_URL="http://localhost:11434/v1"

# --- Legacy Single-Provider GenAI (Used only if GENAI_PRIMARY_PROVIDER is empty)
GENAI_PROVIDER="openai_compatible"
GENAI_MODEL="qwen2.5:3b"
GENAI_PRIMARY_MODEL="qwen2.5:3b"
GENAI_FALLBACK_MODEL_1=""
GENAI_FALLBACK_MODEL_2=""
GENAI_API_KEY="your-genai-api-key"
GENAI_BASE_URL="http://localhost:11434/v1/"

# --- Chat Endpoint Rate Limiting ----------------------------------------------
CHAT_RATE_LIMIT_PER_MINUTE="30"
CHAT_RATE_LIMIT_BURST="10"

# --- Render-Specific Notes ----------------------------------------------------
# Render injects PORT automatically for Web Services. The Dockerfiles default
# to PORT=8000 (backend) and PORT=3000 (frontend) but Render overrides these.
#
# For the backend on Render:
#   PORT=10000  (Render assigns a port; the Dockerfile picks it up)
#   CORS_ORIGINS=https://your-frontend.onrender.com
#   DATABASE_URL=postgresql://...  (from Render PostgreSQL or Supabase)
#   JWT_SECRET=<your-secret>
#   GROQ_API_KEY=<your-key>
#
# For the frontend on Render:
#   FASTAPI_URL=https://your-backend.onrender.com
#   JWT_SECRET=<same-secret-as-backend>
